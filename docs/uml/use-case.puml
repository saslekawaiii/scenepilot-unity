@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam ArrowFontSize 18
skinparam shadowing false
skinparam ArrowColor #087F86
skinparam nodesep 24
skinparam ranksep 30

left to right direction
skinparam usecaseBorderColor #142F46
skinparam usecaseBackgroundColor white
actor "Разработчик" as Developer
actor "Игрок" as Player
rectangle "WorldWeaver 1.2" {
 usecase "Объяснить проект\nAsk" as Ask
 usecase "Просмотреть план\nPlan" as Plan
 usecase "Создать и изменить мир\nExecute" as Execute
 usecase "Проверить код и diff\nперед импортом C#" as Code
 usecase "Восстановить изменения\nзапроса по checkpoint" as Restore
 usecase "Поговорить с NPC" as Talk
 usecase "Двигаться и выполнить\nквест доставки" as Quest
 usecase "Сохранить / загрузить\nсостояние мира" as Save
}
Developer --> Ask
Developer --> Plan
Developer --> Execute
Developer --> Code
Developer --> Restore
Player --> Talk
Player --> Quest
Player --> Save
@enduml
