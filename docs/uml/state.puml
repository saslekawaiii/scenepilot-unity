@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam ArrowFontSize 18
skinparam shadowing false
skinparam ArrowColor #087F86
skinparam nodesep 24
skinparam ranksep 30

skinparam defaultFontSize 22
skinparam ArrowFontSize 20
skinparam stateBorderColor #142F46
skinparam stateBackgroundColor white
top to bottom direction
state "Рабочий цикл NPC" as Cycle {
  state "Готов к запросу\nIdle / Waiting" as Ready
  state "Ожидает модель\nThinking" as Thinking
  state "Двигается\nMoving / Following" as Moving
  [*] --> Ready
  Ready -down-> Thinking : запрос
  Thinking -down-> Moving : движение допустимо
  Moving -up-> Ready : Moving: прибытие\nStopMovement
  Thinking -left-> Ready : речь / Wait / отмена
  Moving -right-> Thinking : новый запрос
}
state "Ошибка\nFailed" as Failed
Thinking -down-> Failed : API / контракт
Failed -up-> Thinking : новый запрос
note bottom of Cycle
  Схема объединяет пары состояний.
  Enum в коде содержит все 6 значений.
end note
@enduml
