@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam ArrowFontSize 18
skinparam shadowing false
skinparam ArrowColor #087F86
skinparam nodesep 20
skinparam ranksep 28
skinparam nodeBackgroundColor #F7F9FC
skinparam nodeBorderColor #52677A
skinparam folderBackgroundColor white
skinparam cloudBackgroundColor #F0F6F5
top to bottom direction
node "Рабочая машина\nApple M4 / macOS / 16 ГБ" as Host {
 node "Unity Editor 6000.3\nWorldWeaver 1.2" as Editor
 folder "UserSettings\nчаты / задачи / backup\nC# / jobs / изображения" as State
 folder "Файлы проекта\nAssets / ProjectSettings\nmanifests / MD-навыки" as Project
 node "Ollama\nлокальная LLM\nEmbeddingGemma" as Ollama
 node "Play Mode / Player\nмир / NPC / квест" as Game
 folder "persistentDataPath\nWorldWeaver/<WorldId>.json" as Save
 Editor -down-> State : журналы
 Editor -down-> Project : данные
 State -[hidden]right-> Project
 State -[hidden]down-> Ollama
 Project -down-> Game : сцена
 Ollama -[hidden]right-> Game
 Editor --> Ollama : loopback HTTP
 Game -left-> Ollama : диалог / RAG
 Game -down-> Save : Save / Load
}
cloud "Pollinations Classic\nвнешний текстовый API\nопционально" as Cloud
Save -[hidden]down-> Cloud
Editor -[norank]-> Cloud : HTTPS
Game -[norank]-> Cloud : выбранный диалог
note bottom of Cloud
 Внешний API получает отобранный контекст.
 Модели и Library не входят в checkpoint.
end note
@enduml
