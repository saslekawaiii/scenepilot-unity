@startuml
' Current physical deployment; the previous runtime 1.0 figure has an archived manifest.
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam shadowing false
skinparam backgroundColor white
skinparam nodesep 20
skinparam ranksep 24
skinparam ArrowColor #45556A
skinparam ArrowFontSize 16
skinparam nodeFontStyle plain
skinparam nodeBackgroundColor #F7F9FC
skinparam nodeBorderColor #566B85
skinparam cloudBackgroundColor #F2F7FF
skinparam legendFontSize 15
top to bottom direction

node "Рабочая машина: Apple M4\nmacOS 15.7.4 / 16 ГБ памяти" as Host {
  node "<b>Unity 6000.3.27f1 / WorldWeaver 1.1.0</b>\n\nEditor: Chat UI / ChatController\nRuntime: IntelligentNPC / ActionDispatcher\nInMemoryVectorStore — индекс в RAM" as Unity
  folder "<b>Файлы Unity-проекта</b>\n\nUserSettings/: история чатов,\nжурнал импортов C# и backup\n\nAssets/WorldWeaverGenerated/:\nTerrain, сцены, материалы,\nзнания NPC; C# после ревью" as Files
  node "<b>Ollama 0.32.6 / Metal</b>\n\nQwen3.5 9B — чат по умолчанию\nQwen3.5 2B — опционально\nQwen2.5-Coder 7,6B — опционально\nEmbeddingGemma 300M — эмбеддинги" as Ollama
  Unity -down-> Files : чтение / запись
  Unity -down-> Ollama : loopback HTTP\n/api/chat, /api/embed
  Files -[hidden]down-> Ollama
}

cloud "<b>Pollinations Classic / GPT-OSS 20B</b>\n\nБез ключа и оплаты (опционально)\n45 с / IP; интервал клиента 46 с\nmax_tokens = 1500 на ответ" as Classic
Unity -down-> Classic : HTTPS\n/openai
Ollama -[hidden]down-> Classic

legend bottom
Показаны установленные модели.
Состав среды не является оценкой скорости.
Модель выбирается профилем задачи;
одновременная загрузка всех весов не требуется.
endlegend
@enduml
