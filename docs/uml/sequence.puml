@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam ArrowFontSize 18
skinparam shadowing false
skinparam ArrowColor #087F86
skinparam nodesep 24
skinparam ranksep 30

skinparam BoxPadding 8
hide footbox
actor "Автор" as User
participant "Контроллер" as Agent
participant "Checkpoint /\nистория" as State
participant "C# / Unity" as Unity
participant "Продолжение" as Resume
User -> Agent : запрос кода
Agent -> Agent : план модели
Agent --> User : код / diff
User -> Agent : Применить
Agent -> State : Begin; scope
Agent -> Unity : просмотренный\nимпорт / patch
Agent -> State : Seal; сохранить\nзадачу ожидания
Unity -> Unity : импорт / compiler;\ndomain reload
Unity -> State : compiler feedback
Resume -> State : загрузить задачу
Resume -> Resume : Unity завершила\nтекущую проверку
Resume -> Agent : ResumeAsync()
Agent -> Unity : сцена / compiler;\nпри необходимости tests
Unity --> Agent : read-back / XML
Agent -> Resume : проверить условия
alt нарушение и бюджет
  Agent -> Agent : исправление в\nпросмотренном scope
else нужен просмотр или конец бюджета
  Agent --> User : итог / нерешённое
end
note over Agent,Resume
  До 3 продолжений. PendingPlan требует просмотра.
  Компиляция не доказывает правильность игры.
end note
@enduml
