@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 22
skinparam ArrowFontSize 20
skinparam shadowing false
skinparam ArrowColor #087F86
skinparam activityBackgroundColor white
skinparam activityBorderColor #142F46
start
:Сохранить запрос, режим\nи явные условия;
:Отобрать контекст\nи MD-навыки;
repeat
 :Получить полный EditorPlan;
 :Проверить контракт\nи разрешения режима;
 if (Нужен просмотр?) then (да)
  :PendingPlan\nждёт применения;
  stop
 else (нет)
  :Только для изменений:\nсоздать или проверить checkpoint;
  :Исполнить допустимые действия\nили чтение в режиме Ask;
  if (Ожидание Unity?) then (да)
   :Сохранить задачу\nдо compiler / Editor job;
   stop
  endif
 endif
 :Прочитать сцену и результаты;\nпроверить извлечённые условия;
repeat while (Исправить в пределах\nоставшегося бюджета?) is (да) not (нет)
:Показать фактический итог\nи нерешённые условия;
stop
@enduml
