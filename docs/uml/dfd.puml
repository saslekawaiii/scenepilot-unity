@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam ArrowFontSize 18
skinparam shadowing false
skinparam ArrowColor #087F86
skinparam nodesep 20
skinparam ranksep 28
skinparam usecaseBorderColor #142F46
skinparam usecaseBackgroundColor white
skinparam databaseBorderColor #52677A
skinparam databaseBackgroundColor #F0F6F5
top to bottom direction
rectangle "Разработчик" as User
usecase "1. Запрос и режим\nChatController" as Chat
database "D1 Чат и задача\nтребования / проверки" as History
usecase "2. Отбор данных\nиндекс / память / MD" as Context
rectangle "LLM" as Model
usecase "3. Проверка плана\nи исполнение" as Execute
database "D2 Unity-проект\nсцены / ассеты / C#" as Project
database "D3 Checkpoint\nBefore / After / WriteSet" as Backup
usecase "4. Проверка результата\nscene / compiler / jobs" as Verify
User -down-> Chat : запрос / просмотр
Chat <-left-> History : задача
Chat -down-> Context : просьба
Context <-right-> Model : контекст / план
Context -down-> Execute : полный план
Execute <-left-> Backup : снимок / Restore
Execute <-right-> Project : данные / read-back
Execute -down-> Verify : результат
Verify -up-> History : проверки
Verify -up-> Chat : итог
History -[hidden]down-> Backup
Model -[hidden]down-> Project
@enduml
