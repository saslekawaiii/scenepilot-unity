@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam ArrowFontSize 18
skinparam shadowing false
skinparam ArrowColor #087F86
skinparam nodesep 24
skinparam ranksep 30

skinparam classBackgroundColor white
skinparam classBorderColor #142F46
hide empty members
class ChatController {
 + SendAsync()
 + ApplyPendingAsync()
 + ResumeAsync()
 + RestoreTask()
}
class ChatSession {
 Messages
 DesignMemory
 Settings
}
class AssistantMessage {
 PendingPlan
 Task : AgentTaskState
 Steps / Attempts
}
class AgentTaskState {
 OriginalRequest / Status
 Requirements / Checks
 CheckpointId / PendingJobId
 ReviewedCodeScope
 ContinueAfterReload
}
class AgentTaskVerifier {
 + Create()
 + Verify()
}
class AgentCheckpoints {
 + Begin() / Seal()
 + CanRestore() / Restore()
}
class AgentEditorJobs {
 + RunTests() / BuildPlayer()
 + RunRotationCheck() / Poll()
}
class EditorPlan {
 reply / complete
 actions : EditorCommand[]
 + Parse()
}
class SceneToolExecutor {
 + Validate()
 + Execute()
}
ChatController --> ChatSession
ChatSession *-- AssistantMessage
AssistantMessage *-- AgentTaskState
AssistantMessage o-- EditorPlan : PendingPlan
ChatController --> AgentTaskVerifier
AgentTaskVerifier --> AgentTaskState
ChatController --> AgentCheckpoints
ChatController --> AgentEditorJobs
ChatController --> SceneToolExecutor
SceneToolExecutor ..> EditorPlan
@enduml
