@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 22
skinparam ArrowFontSize 20
skinparam shadowing false
skinparam componentStyle rectangle
skinparam componentBorderColor #142F46
skinparam componentBackgroundColor white
skinparam ArrowColor #087F86
skinparam nodesep 24
skinparam ranksep 32
top to bottom direction
[Чат Unity Editor] as UI
[Контекст проекта\nиндекс / MD / design memory] as Context
[ChatController\nрежим и цикл задачи] as Agent
[История чата\nTaskState / проверки] as History
[Checkpoint запроса\nAgentCheckpoints] as Backup
[Провайдеры моделей\nILLMProvider] as Models
[Инструменты сцены\nSceneToolExecutor\nWorldGameplayTools] as Scene
[Просмотр и импорт C#\nScriptDrafts / patches] as Code
[Проверка / продолжение\nVerifier / Resume] as Verify
[Задания Unity\nAgentEditorJobs] as Jobs
[Runtime мира\nNPC / RAG / NavMesh\nигрок / квест / Save] as Runtime
UI -[hidden]right-> Context
Agent -[hidden]right-> History
Backup -[hidden]right-> Models
Scene -[hidden]right-> Code
Verify -[hidden]right-> Jobs
UI -down-> Agent
Agent -[hidden]down-> Backup
Backup -[hidden]down-> Scene
Scene -[hidden]down-> Verify
Verify -[hidden]down-> Runtime
Context -[hidden]down-> History
History -[hidden]down-> Models
Models -[hidden]down-> Code
Code -[hidden]down-> Jobs
Agent -[norank]-> Context
Agent -[norank]-> History
Agent -[norank]-> Backup
Agent -[norank]-> Models
Agent -[norank]-> Scene
Agent -[norank]-> Code
Agent -[norank]-> Verify
Agent -[norank]-> Jobs
Code -[norank]-> Verify : compiler
Jobs -[norank]-> Verify : результат
Verify -[norank]-> Agent : продолжение
Scene -[norank]-> Runtime
Runtime -[norank]-> Models
@enduml
