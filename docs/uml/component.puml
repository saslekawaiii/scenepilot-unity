@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam defaultFontSize 16
top to bottom direction
package "WorldWeaver.Editor" {
 [WorldWeaverWindow] as UI
 [TerrainAuthoring] as Author
 [DemoBuilder] as Demo
}
package "WorldWeaver.Runtime" {
 [IntelligentNPC] as NPC
 [NpcPipeline] as Pipeline
 [ModelRouter] as Router
 [LocalProvider] as Local
 [OpenAICompatible\nProvider] as Cloud
 [RagIndex] as RAG
 [OllamaEmbedding\nProvider] as Embedding
 [InMemory\nVectorStore] as Vector
 [ActionDispatcher] as Actions
 [TerrainGenerator] as Generator
}
UI --> Author
UI --> NPC
UI --> Router
Demo --> NPC
Author --> Generator
NPC --> Pipeline
Pipeline --> RAG
Pipeline --> Router
Pipeline --> Actions
RAG --> Embedding
RAG --> Vector
Router --> Local
Router --> Cloud
[Inventory] as Inventory
[NavMeshAgent] as Nav
Actions --> Inventory
Actions --> Nav
Embedding -down[hidden]-> Vector
Local -down[hidden]-> Cloud
Inventory -down[hidden]-> Nav
@enduml
