.ww-chat {
    --chat-bg: #202226;
    --chat-sidebar: #17191c;
    --chat-surface: #2b2e33;
    --chat-hover: #34383e;
    --chat-line: #3b3f45;
    --chat-text: #e9eaec;
    --chat-muted: #a0a5ae;
    --chat-dim: #797f89;
    flex-direction: row;
    flex-grow: 1;
    background-color: var(--chat-bg);
    color: var(--chat-text);
    font-size: 13px;
}

.ww-chat Button {
    color: var(--chat-text);
    background-color: transparent;
    border-width: 0;
    border-radius: 7px;
    margin: 0;
    padding: 7px 10px;
    -unity-text-align: middle-left;
}

.ww-chat Button:hover { background-color: var(--chat-hover); }
.ww-chat Button:disabled { opacity: 0.42; }
.ww-chat Button:focus { border-width: 1px; border-color: #929fb3; }
.chat-text { white-space: normal; margin: 0; padding: 0; }

.sidebar {
    width: 224px;
    min-width: 224px;
    flex-shrink: 0;
    padding: 22px 12px 14px 12px;
    background-color: var(--chat-sidebar);
    border-right-width: 1px;
    border-right-color: #282b30;
}

.brand-row { flex-direction: row; align-items: center; margin: 0 9px 24px 9px; }
.brand-mark {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background-color: #30343a;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: #f2f3f5;
    font-size: 16px;
    margin-right: 10px;
}
.brand-name { font-size: 16px; -unity-font-style: bold; }
.ww-chat .new-chat {
    height: 40px;
    flex-shrink: 0;
    background-color: #26292e;
    border-width: 1px;
    border-color: #34383f;
    border-radius: 9px;
    margin-bottom: 28px;
    padding-left: 13px;
    font-size: 13px;
}
.section-label { color: var(--chat-dim); font-size: 10px; -unity-font-style: bold; margin: 0 11px 10px 11px; }
.history { flex-grow: 1; min-height: 0; }
.history > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding-right: 4px; }
.ww-chat .history-item { padding: 11px 12px; margin-bottom: 4px; border-radius: 8px; }
.ww-chat .history-item.selected { background-color: #2b2e34; }
.history-title { color: #d6d9de; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; font-size: 12px; }
.history-date { color: var(--chat-dim); font-size: 10px; margin-top: 5px; }
.history-empty { color: var(--chat-dim); font-size: 12px; padding: 10px; }
.sidebar-caption { color: var(--chat-dim); font-size: 11px; margin: 20px 11px 0 11px; }

.main { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.header { flex-shrink: 0; padding: 14px 25px 15px 25px; border-bottom-width: 1px; border-bottom-color: #2e3137; }
.header-heading { flex-direction: row; align-items: center; margin-bottom: 12px; }
.ww-chat .history-toggle { width: 29px; height: 28px; padding: 0; font-size: 18px; -unity-text-align: middle-center; margin-right: 9px; color: var(--chat-muted); }
.chat-title { flex-grow: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #d8dce2; font-size: 12px; }
.ww-chat .quiet-button { color: var(--chat-muted); font-size: 11px; padding: 5px 8px; }
.header-controls { flex-direction: row; align-items: flex-end; }
.model-group { flex-grow: 1; min-width: 120px; max-width: 370px; margin-right: 12px; }
.power-group { width: 126px; flex-shrink: 0; margin-right: 12px; }
.field-caption { color: var(--chat-muted); font-size: 10px; margin-bottom: 5px; }
.ww-chat .unity-base-popup-field { margin: 0; }
.ww-chat .unity-base-popup-field__input {
    background-color: #292c31;
    border-width: 1px;
    border-color: #41454e;
    border-radius: 7px;
    color: var(--chat-text);
    padding: 6px 8px;
    min-height: 32px;
}
.ww-chat .unity-base-popup-field__text { font-size: 12px; }
.connection { flex-grow: 1; align-items: flex-end; min-width: 92px; }
.connection-label { font-size: 10px; color: #b4a48f; margin-bottom: 3px; }
.connection-label.connected { color: #a7bcb0; }
.connection .quiet-button { padding-right: 0; }

.conversation { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.conversation > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { align-items: center; }
.conversation-content { width: 100%; max-width: 950px; padding: 28px 32px 24px 32px; }
.welcome { align-items: center; justify-content: center; padding: 38px 0 24px 0; }
.welcome-title { color: #f0f1f3; font-size: 33px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 12px; }
.welcome-subtitle { color: var(--chat-muted); font-size: 16px; -unity-text-align: middle-center; margin-bottom: 32px; }
.prompt-grid { flex-direction: row; flex-wrap: wrap; width: 100%; max-width: 730px; }
.ww-chat .prompt-card {
    width: 48%;
    min-height: 85px;
    margin: 0 1% 12px 1%;
    padding: 15px 17px;
    border-width: 1px;
    border-color: #393d44;
    border-radius: 12px;
    background-color: #26292e;
    align-items: flex-start;
    justify-content: center;
}
.ww-chat .prompt-card:hover { background-color: #2d3137; border-color: #555c66; }
.prompt-title { color: #e1e4e9; font-size: 13px; -unity-font-style: bold; margin-bottom: 8px; }
.prompt-description { color: var(--chat-muted); font-size: 11px; }
.welcome-caption { color: var(--chat-dim); font-size: 11px; margin-top: 15px; }
.message-list { width: 100%; }
.message { width: 100%; margin-bottom: 27px; flex-shrink: 0; }
.message-heading { flex-direction: row; align-items: center; margin-bottom: 10px; }
.message-author { color: #e8eaed; font-size: 12px; -unity-font-style: bold; margin-right: 13px; }
.message-metadata { color: var(--chat-dim); font-size: 10px; flex-grow: 1; }
.message-body { color: #e4e6eb; font-size: 14px; white-space: normal; }
.user-message {
    width: auto;
    max-width: 88%;
    align-self: flex-end;
    padding: 15px 18px 10px 18px;
    border-radius: 16px;
    background-color: #30343b;
}
.user-message .message-body { color: #f0f1f3; }
.user-message .message-metadata { display: none; }
.assistant-message { padding: 8px 0 0 0; }
.message-status { color: var(--chat-muted); font-size: 11px; margin-top: 9px; }
.error-message .message-status { color: #d6b39b; }
.error-message { border-left-width: 2px; border-left-color: #99735b; padding-left: 15px; }
.message-actions { flex-direction: row; align-items: center; margin-top: 8px; flex-wrap: wrap; }
.ww-chat .message-action { color: var(--chat-dim); font-size: 10px; padding: 4px 7px; margin-right: 4px; }
.ww-chat .message-action:hover { color: #d8dce3; }
.ww-chat .apply-plan { background-color: #e1e5e9; color: #23262c; padding: 7px 13px; font-size: 11px; margin-left: 6px; border-radius: 7px; }
.ww-chat .apply-plan:hover { background-color: #ffffff; }
.message-steps { margin-top: 10px; }
.ww-chat .unity-foldout__toggle { color: var(--chat-muted); margin: 0; padding-top: 5px; padding-bottom: 5px; }
.ww-chat .unity-foldout__content { margin-left: 14px; }
.step-result { margin: 7px 0; padding: 7px 10px; border-left-width: 1px; border-left-color: #4a5059; }
.step-success { color: #afc1b4; font-size: 10px; margin-bottom: 4px; }
.step-failure { color: #d8b59f; font-size: 10px; margin-bottom: 4px; }
.step-description { color: #c7ccd3; font-size: 12px; }
.step-assets { color: var(--chat-muted); font-size: 10px; margin-top: 6px; }
.step-error { color: #cfa88f; font-size: 11px; margin-top: 6px; }
.plan-review { border-width: 1px; border-color: #454b55; border-radius: 10px; background-color: #272a30; padding: 14px; margin-top: 15px; }
.review-title { color: #dce0e7; font-size: 12px; -unity-font-style: bold; margin-bottom: 11px; }
.review-description, .review-action { color: #c4cad2; font-size: 12px; margin: 5px 0; }
.review-caption { color: var(--chat-muted); font-size: 11px; margin-top: 9px; }
.code-preview { height: 250px; margin: 9px 0; }
.ww-chat .code-preview .unity-text-field__input { background-color: #1c1f24; color: #d7dce4; border-width: 1px; border-color: #3c424c; border-radius: 7px; padding: 10px; font-size: 12px; white-space: pre; }

.composer-area { width: 100%; max-width: 950px; align-self: center; padding: 0 26px 16px 26px; flex-shrink: 0; }
.composer-shell { background-color: #2c3036; border-width: 1px; border-color: #484e58; border-radius: 17px; padding: 12px 13px 10px 13px; }
.composer-input { position: relative; min-height: 71px; }
.composer-field { min-height: 71px; max-height: 160px; flex-grow: 1; margin: 0; }
.ww-chat .composer-field .unity-text-field__input { background-color: transparent; border-width: 0; color: #f0f1f3; padding: 3px 3px 7px 3px; font-size: 14px; white-space: normal; }
.ww-chat .composer-field:focus .unity-text-field__input { border-width: 0; }
.composer-placeholder { position: absolute; left: 3px; top: 4px; right: 3px; color: #a6acb5; font-size: 14px; }
.composer-controls { flex-direction: row; align-items: center; margin-top: 4px; }
.ww-chat .add-task { width: 31px; height: 31px; padding: 0; -unity-text-align: middle-center; font-size: 22px; color: #dce0e5; border-radius: 8px; }
.auto-apply { flex-grow: 1; flex-shrink: 1; margin: 0 10px; color: #aeb5bf; font-size: 10px; }
.auto-apply .unity-toggle__label { min-width: 0; white-space: normal; }
.auto-apply .unity-toggle__input { margin-right: 5px; }
.ww-chat .send-button { min-width: 92px; height: 34px; -unity-text-align: middle-center; background-color: #e8ebef; color: #252930; border-radius: 10px; font-size: 12px; -unity-font-style: bold; }
.ww-chat .send-button:hover { background-color: #ffffff; }
.ww-chat .send-button.stop-button { background-color: #4b515b; color: #f1f3f6; border-width: 1px; border-color: #6a7381; }
.composer-footer { flex-direction: row; align-items: flex-start; justify-content: space-between; margin-top: 10px; }
.phase-label { flex-grow: 1; flex-shrink: 1; color: var(--chat-dim); font-size: 10px; margin-right: 10px; }
.phase-label.working { color: #cbd0d8; }
.keyboard-hint { color: var(--chat-dim); font-size: 9px; -unity-text-align: middle-right; }
.attachment { flex-direction: row; align-items: center; align-self: flex-start; max-width: 100%; background-color: #3a4049; border-radius: 6px; padding: 4px 5px 4px 9px; margin-bottom: 10px; }
.attachment-label { color: #d4dbe4; font-size: 11px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; flex-shrink: 1; }
.ww-chat .attachment-remove { width: 22px; height: 22px; padding: 0; margin-left: 7px; -unity-text-align: middle-center; font-size: 17px; color: #c7cdd5; }
.notice { flex-direction: row; align-items: center; background-color: #30363d; border-radius: 8px; padding: 9px 12px; margin-bottom: 10px; }
.notice.notice-error { background-color: #39312d; border-left-width: 2px; border-left-color: #a07b61; }
.notice-text { color: #cdd3dc; font-size: 11px; flex-grow: 1; flex-shrink: 1; }
.ww-chat .notice-dismiss { padding: 0; width: 23px; height: 23px; -unity-text-align: middle-center; font-size: 18px; color: #c7cdd4; margin-left: 8px; }
.task-menu { position: absolute; bottom: 80px; left: 39px; width: 285px; padding: 13px 7px 7px 7px; border-width: 1px; border-color: #4b525e; border-radius: 11px; background-color: #2b3037; }
.task-menu .section-label { margin-left: 11px; margin-bottom: 9px; }
.ww-chat .task-option { font-size: 12px; padding: 9px 11px; border-radius: 6px; }
.task-separator { height: 1px; background-color: #454c57; margin: 7px 10px; }
