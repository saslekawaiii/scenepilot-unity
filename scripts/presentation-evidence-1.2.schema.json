{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Final WorldWeaver 1.2 presentation evidence",
  "description": "Describes provenance inputs, not example results. Populate only after final source freeze and actual completed protocols. The builder never falls back to v1.1 metrics.",
  "type": "object",
  "required": ["version", "finalized", "sourceCommit", "sourceHashes", "testRuns", "modelRuns", "screenshots"],
  "properties": {
    "version": {"const": "1.2"},
    "finalized": {"const": true},
    "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
    "sourceHashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "testRuns": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {"type": "object", "required": ["label", "path", "scope"], "properties": {"label": {"type": "string"}, "path": {"type": "string"}, "scope": {"type": "string"}}}
    },
    "modelRuns": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "required": ["label", "path", "sha256", "sourceCommit", "sourceSnapshot", "sourceTreeSha256"],
        "properties": {
          "label": {"type": "string"}, "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
          "sourceSnapshot": {"type": "string"},
          "sourceTreeSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "finishedField": {"type": "string", "default": "finishedUtc"},
          "casesField": {"type": "string", "default": "tests"},
          "passField": {"type": "string", "default": "passed"},
          "modelField": {"type": "string", "default": "modelKey"}
        }
      }
    },
    "checkRuns": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "required": ["label", "path", "sha256", "scope"],
        "properties": {
          "label": {"type": "string"}, "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "scope": {"type": "string"},
          "passedField": {"type": "string", "default": "passedChecks"},
          "totalField": {"type": "string", "default": "totalChecks"},
          "finishedField": {"type": "string", "default": "finishedUtc"},
          "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"}
        }
      }
    },
    "observations": {"type": "array", "items": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}}}},
    "screenshots": {"type": "object", "required": ["ui", "world", "api"], "properties": {"ui": {"$ref": "#/definitions/screenshot"}, "world": {"$ref": "#/definitions/screenshot"}, "api": {"$ref": "#/definitions/screenshot"}, "skills": {"$ref": "#/definitions/screenshot"}}},
    "testCaption": {"type": "string"},
    "modelCaption": {"type": "string"},
    "modelLimitation": {"type": "string"},
    "runtimeCaption": {"type": "string"},
    "runtimeProof": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "visionSummary": {"type": "string"},
    "visionObservation": {"type": "object", "required": ["path", "sha256", "strictAutomatedPass"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "strictAutomatedPass": {"const": false}}},
    "outcomes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
    "conclusionLimitation": {"type": "string"}
  },
  "definitions": {
    "screenshot": {
      "type": "object", "required": ["path", "caption", "sha256"],
      "properties": {"path": {"type": "string"}, "caption": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    }
  }
}
