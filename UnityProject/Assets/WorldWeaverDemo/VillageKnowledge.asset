  Documents:
  - Id: village
    Scope: merchant
    Title: "\u0414\u0435\u0440\u0435\u0432\u043D\u044F"
    Text: "\u0414\u0435\u0440\u0435\u0432\u043D\u044F \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u041B\u0443\u043D\u043D\u044B\u0439 \u0411\u0440\u043E\u0434. \u0415\u0451
      \u043E\u0441\u043D\u043E\u0432\u0430\u043B\u0430 \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444
      \u0410\u044D\u043B\u043B\u0430 \u0432 417 \u0433\u043E\u0434\u0443 \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u043B\u0435\u0442\u043E\u0438\u0441\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F.
      \u0414\u0435\u0440\u0435\u0432\u043D\u044F \u0441\u0442\u043E\u0438\u0442 \u0443
      \u0440\u0435\u043A\u0438 \u0422\u0438\u0445\u0430\u044F."
    Kind: 0
  - Id: crystal
    Scope: merchant
    Title: "\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B"
    Text: "\u041B\u0435\u0447\u0435\u0431\u043D\u044B\u0439 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B
      \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0417\u043E\u0440\u0435\u0446\u0432\u0435\u0442.
      \u0415\u0433\u043E \u0434\u043E\u0431\u044B\u0432\u0430\u044E\u0442 \u0432
      \u0448\u0430\u0445\u0442\u0435 \u0421\u0435\u043C\u0438 \u0412\u0435\u0442\u0440\u043E\u0432.
      \u041E\u0431\u044B\u0447\u043D\u0430\u044F \u0446\u0435\u043D\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430 \u2014 7 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445
      \u043C\u043E\u043D\u0435\u0442. \u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B
      \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F \u0432 \u0441\u0438\u043D\u0435\u043C
      \u0441\u0443\u043D\u0434\u0443\u043A\u0435."
    Kind: 0
  - Id: healer
    Scope: merchant
    Title: "\u041B\u0435\u043A\u0430\u0440\u044C"
    Text: "\u041B\u0435\u043A\u0430\u0440\u044F \u0434\u0435\u0440\u0435\u0432\u043D\u0438
      \u0437\u043E\u0432\u0443\u0442 \u042D\u0440\u0438\u043D\u0430. \u041E\u043D\u0430
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442 \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043A\u0430\u0442\u0430.
      \u0414\u043B\u044F \u043D\u0430\u0441\u0442\u043E\u044F \u043E\u0442 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0438
      \u042D\u0440\u0438\u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043B\u0438\u0441\u0442."
    Kind: 0
  - Id: merchant
    Scope: merchant
    Title: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446"
    Text: "\u0422\u043E\u0440\u0433\u043E\u0432\u0446\u0430 \u0437\u043E\u0432\u0443\u0442
      \u041C\u0438\u0440\u043E\u043D. \u0415\u0433\u043E \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u043C
      \u0431\u044B\u043B \u043A\u0443\u043F\u0435\u0446 \u0411\u0435\u0440\u0435\u043D.
      \u041C\u0438\u0440\u043E\u043D \u0431\u043E\u0438\u0442\u0441\u044F \u0432\u043E\u043B\u043A\u043E\u0432.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0430\u044F \u043B\u0430\u0432\u043A\u0430
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430
      \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u0440\u0438 \u0432\u0442\u043E\u0440\u043E\u043C \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u043C
      \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u0435."
    Kind: 0
  - Id: house
    Scope: merchant
    Title: "\u0414\u043E\u043C"
    Text: "\u0414\u043E\u043C \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0443 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0433\u043E \u043A\u0440\u0430\u044F
      \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u0438.
      \u041D\u0430\u0434 \u0434\u0432\u0435\u0440\u044C\u044E \u0432\u0438\u0441\u0438\u0442
      \u043C\u0435\u0434\u043D\u044B\u0439 \u043F\u043E\u043B\u0443\u043C\u0435\u0441\u044F\u0446.
      \u041F\u043E\u0441\u043B\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438
      \u041C\u0438\u0440\u043E\u043D \u043E\u0431\u044B\u0447\u043D\u043E \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u0434\u043E\u043C."
    Kind: 0
  - Id: well
    Scope: merchant
    Title: "\u041A\u043E\u043B\u043E\u0434\u0435\u0446"
    Text: "\u041A\u043E\u043B\u043E\u0434\u0435\u0446 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0417\u0435\u0440\u043A\u0430\u043B\u044C\u043D\u044B\u0439. \u0415\u0433\u043E
      \u0433\u043B\u0443\u0431\u0438\u043D\u0430 \u2014 18 \u043B\u043E\u043A\u0442\u0435\u0439.
      \u0412\u043E\u0434\u0443 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044C \u0422\u0430\u0440\u0435\u043D
      \u043F\u043E \u043F\u043E\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A\u0430\u043C.
      \u041A\u043B\u044E\u0447 \u043E\u0442 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F
      \u0443 \u042D\u0440\u0438\u043D\u044B."
    Kind: 0
  - Id: festival
    Scope: merchant
    Title: "\u041F\u0440\u0430\u0437\u0434\u043D\u0438\u043A"
    Text: "\u041F\u0440\u0430\u0437\u0434\u043D\u0438\u043A \u0423\u0440\u043E\u0436\u0430\u044F
      \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442 12 \u0434\u043D\u044F \u043C\u0435\u0441\u044F\u0446\u0430
      \u0422\u0443\u043C\u0430\u043D\u043E\u0432. \u0421\u0438\u043C\u0432\u043E\u043B
      \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0430 \u2014 \u0431\u0435\u043B\u044B\u0439
      \u0444\u043E\u043D\u0430\u0440\u044C. \u041D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438
      \u0438\u0441\u043F\u043E\u043B\u043D\u044F\u044E\u0442 \u043F\u0435\u0441\u043D\u044E
      \u0421\u0435\u043C\u044C \u043C\u043E\u0441\u0442\u043E\u0432."
    Kind: 0
  - Id: bridge
    Scope: merchant
    Title: "\u041C\u043E\u0441\u0442"
    Text: "\u0421\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u043C\u043E\u0441\u0442
      \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D \u0438\u0437 \u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F. \u0417\u0430 \u043F\u0440\u043E\u0445\u043E\u0434
      \u0431\u0435\u0440\u0443\u0442 2 \u043C\u0435\u0434\u043D\u044B\u0435 \u043C\u043E\u043D\u0435\u0442\u044B.
      \u041F\u043E\u0441\u043B\u0435 \u043D\u0430\u0432\u043E\u0434\u043D\u0435\u043D\u0438\u044F
      \u043F\u0440\u043E\u0445\u043E\u0434 \u0440\u0430\u0437\u0440\u0435\u0448\u0451\u043D
      \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043E \u043F\u043E\u043B\u0443\u0434\u043D\u044F."
    Kind: 0
  - Id: mine
    Scope: merchant
    Title: "\u0428\u0430\u0445\u0442\u0430"
    Text: "\u0412\u0445\u043E\u0434 \u0432 \u0448\u0430\u0445\u0442\u0443 \u0421\u0435\u043C\u0438
      \u0412\u0435\u0442\u0440\u043E\u0432 \u043E\u0442\u043C\u0435\u0447\u0435\u043D
      \u0442\u0440\u0435\u043C\u044F \u0441\u0438\u043D\u0438\u043C\u0438 \u043F\u043E\u043B\u043E\u0441\u0430\u043C\u0438.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0448\u0430\u0445\u0442\u0451\u0440
      \u2014 \u0414\u043E\u0440\u0438\u043D. \u041E\u0431\u0432\u0430\u043B \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0451\u043B
      \u0432 429 \u0433\u043E\u0434\u0443. \u042E\u0436\u043D\u0430\u044F \u0448\u0442\u043E\u043B\u044C\u043D\u044F
      \u0437\u0430\u043A\u0440\u044B\u0442\u0430."
    Kind: 0
  - Id: library
    Scope: merchant
    Title: "\u0411\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430"
    Text: "\u0410\u0440\u0445\u0438\u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0438
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D \u0432 \u0431\u0430\u0448\u043D\u0435
      \u0418\u0432. \u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0443
      \u0437\u043E\u0432\u0443\u0442 \u0421\u0435\u043B\u0438\u044F. \u0421\u0430\u043C\u0430\u044F
      \u0441\u0442\u0430\u0440\u0430\u044F \u043A\u043D\u0438\u0433\u0430 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u041A\u0430\u0440\u0442\u0430 \u0437\u0438\u043C\u043D\u0435\u0433\u043E \u043D\u0435\u0431\u0430."
    Kind: 0
  - Id: guard-secret
    Scope: guard
    Title: "\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u044B\u0439 \u043F\u0430\u0440\u043E\u043B\u044C"
    Text: "\u0421\u0442\u0440\u0430\u0436 \u041B\u0430\u0434\u0430 \u0437\u043D\u0430\u0435\u0442
      \u043F\u0430\u0440\u043E\u043B\u044C \u043D\u043E\u0447\u043D\u043E\u0433\u043E
      \u043A\u0430\u0440\u0430\u0443\u043B\u0430: \u044F\u043D\u0442\u0430\u0440\u043D\u0430\u044F
      \u0441\u043E\u0432\u0430. \u0422\u043E\u0440\u0433\u043E\u0432\u0446\u0443
      \u044D\u0442\u043E\u0442 \u043F\u0430\u0440\u043E\u043B\u044C \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D."
    Kind: 0
